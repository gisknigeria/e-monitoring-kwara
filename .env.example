PORT=5000
NODE_ENV=production
SESSION_TTL=30d
SESSION_COOKIE_MAX_AGE=2592000
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-character-secret
CORS_ORIGIN=http://127.0.0.1:5173
# Frontend builds on Vercel must set this to the public Render service URL.
VITE_API_URL=https://e-monitoring.onrender.com
ADMIN_EMAIL=admin@command.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SUPER_ADMIN_EMAIL=superadmin@command.local
SUPER_ADMIN_PASSWORD=replace-with-a-strong-hidden-super-admin-password
DATA_FILE=/data/data.json
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Persistent disk path for uploaded evidence (photos/videos) -- required in production, or files are lost on every redeploy.
EVIDENCE_STORAGE_DIR=/data/private-evidence
# Shared Socket.IO adapter. Leave EMPTY for a single instance -- the server then runs single-process,
# which is correct and needs no Redis. Set it ONLY when running more than one instance: without it,
# a second instance does not scale the realtime layer, it breaks it (an agent on instance A and an
# admin on instance B never see each other's events). If it is set and Redis is unreachable, the
# server refuses to start rather than run a silently broken cluster.
REDIS_URL=
# Malware scanning is required before any photo/video is accepted -- without one configured, every upload is quarantined.
# Option A (recommended, free, no account needed): point at a running ClamAV daemon, e.g. the official `clamav/clamav-daemon` image.
CLAMD_HOST=
CLAMD_PORT=3310
# Option B: an HTTP scanning service instead of clamd. Used only if CLAMD_HOST is not set.
EVIDENCE_SCANNER_URL=
# TEMPORARY ONLY. Accepts photo/video uploads even with no scanner connected, instead of
# quarantining them. Never blocks an upload the scanner actually flags as malicious -- only
# skips the check when no scanner is reachable at all. Every use is logged loudly and the
# affected evidence record is marked unscanned in its own audit trail, never faked as clean.
# Turn this off the moment CLAMD_HOST or EVIDENCE_SCANNER_URL is working.
ALLOW_UNSCANNED_EVIDENCE=false
GOOGLE_MAPS_API_KEY=
VITE_MAPTILER_KEY=
VITE_TOMTOM_KEY=
VITE_POSITIONSTACK_KEY=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=86400
EXPRESSTURN_URLS=
EXPRESSTURN_USERNAME=
EXPRESSTURN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
GNEWS_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_NEWS_MODEL=groq/compound-mini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
IREV_OYO_ELECTION_ID=
IREV_AUTO_SYNC=false
ENABLE_OSUN_PILOT=true
# Set true when deploying the backend separately from the React frontend.
API_ONLY=false
REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org
